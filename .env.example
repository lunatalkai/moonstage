# Copy to .env.local for personal overrides (.env.local is gitignored).
#
# Chat stream endpoint. Must be an absolute ws:// or wss:// URL; the HTTP API
# origin is derived from it unless VITE_API_ORIGIN is set.
VITE_WS_BASE=wss://api.lunatalk.ai

# Point the dev proxy (/api) at another API origin, e.g. a local server.
# DEV_PROXY_API=http://localhost:8888
# VITE_WS_BASE=ws://localhost:8888
