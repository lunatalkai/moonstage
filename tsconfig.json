{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/pages/canvas/*.ts",
    "src/pages/canvas/components/*.ts",
    "src/pages/canvas/components/*.vue",
    "src/sandbox/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "src/pages/canvas/__tests__/**",
    "src/sandbox/__tests__/**"
  ]
}
