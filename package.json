{
  "name": "moonstage",
  "version": "0.1.0",
  "scripts": {
    "dev:h5": "uni",
    "dev:h5:local": "DEV_PROXY_API=http://localhost:8888 VITE_WS_BASE=ws://localhost:8888 uni",
    "build:h5": "uni build",
    "build:h5:prod": "npm run check:endpoints && uni build --mode production",
    "check:endpoints": "node scripts/check-hardcoded-endpoints.mjs",
    "i18n:check": "node scripts/i18n-check.js",
    "test": "vitest run",
    "build:stage": "vite build --config vite.stage.config.ts --mode production",
    "check:stage-boundary": "node scripts/check-stage-boundary.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4060620250520001",
    "@dcloudio/uni-components": "3.0.0-4060620250520001",
    "@dcloudio/uni-h5": "3.0.0-4060620250520001",
    "ant-design-vue": "4.2.5",
    "crypto-js": "3.3.0",
    "js-base64": "^3.7.7",
    "markdown-it": "^14.1.0",
    "opencc-js": "1.4.2",
    "pinia": "^2.3.1",
    "vue": "^3.4.21",
    "vue-i18n": "9.1.9",
    "vuex": "4",
    "vuex-persistedstate": "^4.1.0"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-4060620250520001",
    "@dcloudio/uni-stacktracey": "3.0.0-4060620250520001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4060620250520001",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/runtime-core": "^3.4.21",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^24.1.3",
    "sass": "^1.89.2",
    "typescript": "^5.9.3",
    "vite": "5.2.8",
    "vitest": "^1.6.1",
    "vue-tsc": "^3.3.8"
  },
  "private": true,
  "description": "Open chat stage for LunaTalk character cards. SillyTavern / MMD compatible rendering, talks only to the public /open/v1 API.",
  "exports": {
    "./stage": "./dist-stage/moonstage-stage.js",
    "./stage.css": "./dist-stage/moonstage-stage.css"
  },
  "files": [
    "dist-stage"
  ]
}
